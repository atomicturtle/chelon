[Unit]
Description=Chelon Remote Signing Service
After=network.target

[Service]
Type=simple
User=chelon
Group=chelon
WorkingDirectory=/usr/share/chelon/server
Environment="CHELON_HOST=0.0.0.0"
Environment="CHELON_PORT=5050"
Environment="CHELON_CONFIG=/etc/chelon/chelon.conf"
ExecStart=/usr/bin/python3 /usr/share/chelon/server/chelon-service.py
Restart=always
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ReadWritePaths=/var/lib/chelon

# Network isolation
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Capability restriction
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes

# Application sandboxing
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
