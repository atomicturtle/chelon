#!/usr/bin/env python3
"""
Oracle Admin CLI Tool
Manage tokens and view audit logs
"""

import os
import sys
import argparse
import json
import subprocess
from pathlib import Path

# Add server directory to path
# Try local path first (dev environment), then fallback to installed path
local_path = os.path.join(os.path.dirname(__file__), '../server')
if os.path.isdir(local_path):
    sys.path.insert(0, local_path)
else:
    sys.path.insert(0, '/usr/share/chelon/server')

from auth import TokenAuth
from audit import AuditLogger


def generate_token(args):
    """Generate a new API token"""
    auth = TokenAuth(config_file=args.config)
    permissions = args.permissions.split(',')
    token = auth.generate_token(args.name, permissions, args.rate_limit)
    print(f"Generated token for '{args.name}':")
    print(f"  Token: {token}")
    print(f"  Permissions: {', '.join(permissions)}")
    print(f"  Rate limit: {args.rate_limit} req/hour")
    print()
    print("Store this token securely - it cannot be retrieved later!")


def list_tokens(args):
    """List all tokens"""
    auth = TokenAuth(config_file=args.config)
    tokens = auth.list_tokens()
    
    if not tokens:
        print("No tokens found")
        return
    
    print(f"{'Token ID':<30} {'Permissions':<40} {'Created':<25} {'Last Used':<25}")
    print("-" * 120)
    for token in tokens:
        perms = ', '.join(token['permissions'])
        created = token['created']
        last_used = token.get('last_used') or 'Never'
        print(f"{token['token_id']:<30} {perms:<40} {created:<25} {last_used:<25}")


def revoke_token(args):
    """Revoke a token"""
    auth = TokenAuth(config_file=args.config)
    auth.revoke_token(args.name)
    print(f"Revoked token: {args.name}")


def view_audit(args):
    """View audit logs from journald"""
    # Use journalctl to fetch logs
    # -u chelon: Service unit
    # -o json: Output as JSON stream
    # -n limit: Limit number of lines (we fetch more and filter)
    # We grep for AUDIT_ENTRY in the message since Python logging doesn't set syslog identifier
    cmd = [
        'journalctl',
        '-u', 'chelon',
        '-o', 'json',
        '-n', str(args.limit * 10),  # Fetch more to account for non-audit logs
        '--no-pager'
    ]
    
    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"Error fetching logs: {result.stderr}")
            # Fallback (maybe not running as root or journald issue)
            print("Tip: Ensure you are running with sufficient permissions (sudo) to read journal logs.")
            return

        logs = []
        for line in result.stdout.splitlines():
            try:
                journal_entry = json.loads(line)
                message = journal_entry.get('MESSAGE', '')
                # Message format is "AUDIT_ENTRY: {json}"
                if message.startswith('AUDIT_ENTRY: '):
                    audit_json = message[len('AUDIT_ENTRY: '):]
                    logs.append(json.loads(audit_json))
            except json.JSONDecodeError:
                continue

        # Limit to requested number
        logs = logs[-args.limit:]

        if not logs:
            print("No audit logs found in journal")
            return

        for log in logs:
            status = "✓" if log.get('success') else "✗"
            print(f"{status} {log.get('timestamp')} | {log.get('token_id')} | {log.get('operation')} | {log.get('key_used', 'N/A')}")
            if not log.get('success') and 'error' in log:
                print(f"  Error: {log['error']}")
                
    except FileNotFoundError:
        print("Error: 'journalctl' command not found. Is systemd installed?")
    except Exception as e:
        print(f"Error viewing audit logs: {e}")


def main():
    parser = argparse.ArgumentParser(description='Chelon Administration Tool')
    parser.add_argument('--config', default=os.environ.get('CHELON_CONFIG', '/etc/chelon/chelon.conf'),
                       help='Path to configuration file')
    subparsers = parser.add_subparsers(dest='command', help='Command to execute')
    
    # Generate token
    gen_parser = subparsers.add_parser('generate-token', help='Generate a new API token')
    gen_parser.add_argument('name', help='Token identifier')
    gen_parser.add_argument('--permissions', default='sign:rpm,sign:repodata',
                           help='Comma-separated permissions (default: sign:rpm,sign:repodata)')
    gen_parser.add_argument('--rate-limit', type=int, default=100,
                           help='Rate limit (requests per hour, default: 100)')
    
    # List tokens
    subparsers.add_parser('list-tokens', help='List all tokens')
    
    # Revoke token
    rev_parser = subparsers.add_parser('revoke-token', help='Revoke a token')
    rev_parser.add_argument('name', help='Token identifier to revoke')
    
    # View audit logs
    audit_parser = subparsers.add_parser('audit', help='View audit logs')
    audit_parser.add_argument('--limit', type=int, default=100,
                             help='Number of recent logs to show (default: 100)')
    
    args = parser.parse_args()
    
    if not args.command:
        parser.print_help()
        return 1
    
    # Execute command
    if args.command == 'generate-token':
        generate_token(args)
    elif args.command == 'list-tokens':
        list_tokens(args)
    elif args.command == 'revoke-token':
        revoke_token(args)
    elif args.command == 'audit':
        view_audit(args)
    
    return 0


if __name__ == '__main__':
    sys.exit(main())
